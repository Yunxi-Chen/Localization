- [blocks_head_0_0, '0', blocks_file_meta_sink_1, '0']
- [blocks_head_0_0, '0', blocks_file_sink_0_0, '0']
- [blocks_head_0_0_0, '0', blocks_file_sink_0_0_1, '0']
- [blocks_head_0_1, '0', blocks_file_sink_0_0_0, '0']
- [blocks_throttle2_0, '0', blocks_head_0, '0']
- [blocks_throttle2_0_0, '0', blocks_head_0_0, '0']
- [blocks_throttle2_0_0_0, '0', blocks_head_0_1, '0']
- [blocks_throttle2_0_0_1, '0', blocks_head_0_0_0, '0']
- [epy_block_0, '0', blocks_throttle2_0, '0']
- [epy_block_0, '1', blocks_throttle2_0_0, '0']
- [epy_block_0, '2', blocks_throttle2_0_0_0, '0']
- [epy_block_0, '3', blocks_throttle2_0_0_1, '0']

